{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run & Push",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { python \"${file}\"; git add .; git commit -m \"Auto commit from VS Code\"; git push origin master }"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}